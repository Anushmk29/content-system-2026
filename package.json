{
  "name": "content-system-host",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Next.js host that serves the Content Pipeline dashboard at /content. The real engine lives in content-pipeline/.",
  "scripts": {
    "predev": "npm --prefix content-pipeline run build",
    "dev": "next dev --turbopack -p 3001",
    "prebuild": "npm --prefix content-pipeline run build",
    "build": "next build --turbopack",
    "start": "next start",
    "engine:test": "npm --prefix content-pipeline test",
    "test": "node --test src/app/content/_lib/*.test.ts && npm run engine:test",
    "migrate": "npm --prefix content-pipeline run migrate",
    "pipeline": "npm --prefix content-pipeline run pipeline"
  },
  "dependencies": {
    "@pratapai/content-pipeline": "file:./content-pipeline",
    "next": "^15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "^8.5.33"
  },
  "engines": {
    "node": ">=22.18"
  }
}
