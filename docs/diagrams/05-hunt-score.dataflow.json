      "title": "From hunt-score.ts",
      "items": [
        "demand = 0.5·min(b/8, 1) + 0.25·pct(ER) + 0.25·pct(reach)",
        "paid = ER < 0.002, or ER < 0.006 with b > 3, or Jev sponsored ≥ 0.8",
