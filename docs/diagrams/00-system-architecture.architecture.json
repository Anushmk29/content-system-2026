    {
      "dot": "rose",
      "title": "Gate",
      "items": [
        "middleware.ts strips any browser x-content-role, then sets it from the content_session cookie or x-content-secret",
        "guard.ts: GET for any role; writes client-only; admin paths deniedAdmin"
      ]
    },
    {
      "dot": "emerald",
      "title": "Engine",
      "items": [
        "context.ts buildContext(): env → db + adapters + logger",
        "MODULES: market signals → research → score → draft → QC → publish → own results → analytics → weekly review",
        "costRecorder writes every paid call to content.cost_events"
      ]
    },
    {
      "dot": "violet",
      "title": "Providers",
      "items": [
        "claude adapter prefers OpenRouter, falls back to Anthropic Messages",
        "Jev typed decisions via openrouter.ai/api/alpha/decisions",
        "Decode: Apify actors, YouTube Data API v3, local yt-dlp + faster-whisper"
      ]
    }
