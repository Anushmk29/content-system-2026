  "cards": [
    {
      "dot": "rose",
      "title": "src/middleware.ts",
      "items": [
        "Drops browser x-content-role; role from x-content-secret or content_session",
        "openMode() (no CONTENT_RUN_SECRET): 503 in production, admin in dev; non-admin on ADMIN_PATHS gets 403"
      ]
    },
    {
      "dot": "violet",
      "title": "auth.ts + login",
      "items": [
        "Admin password wins; cookie role.expiry.sig, HMAC-SHA256, 30 days",
        "DELETE /content/api/login clears the cookie (maxAge 0)"
      ]
    },
    {
      "dot": "amber",
      "title": "guard.ts",
      "items": [
        "No role: 401 locked; GET passes; admin writes 403 View only",
        "deniedAdmin: 403 admin only; handle() turns throws into 400"
      ]
    }
