  "cards": [
    {
      "dot": "rose",
      "title": "Two roles",
      "items": [
        "Client password: full use; every write is logged",
        "Admin password: view only, plus admin-only pages",
        "GET is always allowed; DELETE /content/api/login clears the cookie"
      ]
    },
    {
      "dot": "amber",
      "title": "Middleware gates",
      "items": [
        "Browser-sent x-content-role is stripped, then set from the cookie or secret",
        "Writes need same Origin unless x-content-secret is used; spend routes 30/min per role",
        "Secret header: 20 tries/min per IP; the cron secret opens only the run routes, as client"
      ]
    },
    {
      "dot": "cyan",
      "title": "Errors",
      "items": [
        "Postgres errors are logged server-side, browser gets a generic 500",
        "Any other throw becomes 400 with its message"
      ]
    }
  ]
