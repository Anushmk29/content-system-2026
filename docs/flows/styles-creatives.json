{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Styles and Creative Generation",
    "animation": "trace",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "frontend": {
          "label": "HTTP route"
        },
        "backend": {
          "label": "Engine function"
        },
        "database": {
          "label": "Postgres table"
        },
        "external": {
          "label": "OpenRouter model"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "ui",
      "label": "Routes · app/content/api"
    },
    {
      "id": "engine",
      "label": "Engine · style-service"
    },
    {
      "id": "data",
      "label": "OpenRouter + Postgres"
    }
  ],
  "phases": [
    {
      "id": "analyse",
      "label": "Analyse once",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "template",
      "label": "Template",
      "fromCol": 2,
      "toCol": 2,
      "variant": "emphasis"
    },
    {
      "id": "make",
      "label": "Draft + generate",
      "fromCol": 3,
      "toCol": 4
    },
    {
      "id": "serve",
      "label": "Item asset",
      "fromCol": 5,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "upload",
    "create",
    "llm",
    "tpl",
    "styles",
    "draft",
    "gen",
    "assets"
  ],
  "nodes": [
    {
      "id": "upload",
      "lane": "ui",
      "col": 0,
      "type": "frontend",
      "label": "POST /styles",
      "sublabel": "1-10 example images",
      "width": 132
    },
    {
      "id": "fix",
      "lane": "ui",
      "col": 2,
      "type": "frontend",
      "label": "POST /styles/:id",
      "sublabel": "note → remakeTemplate",
      "tag": "preview $0",
      "width": 132
    },
    {
      "id": "editor",
      "lane": "ui",
      "col": 5,
      "type": "frontend",
      "label": "/items/:id/asset",
      "sublabel": "POST · DELETE · GET ?i=",
      "width": 132
    },
    {
      "id": "create",
      "lane": "engine",
      "col": 0,
      "type": "backend",
      "label": "createStyle",
      "sublabel": "one image or carousel",
      "width": 132
    },
    {
      "id": "tpl",
      "lane": "engine",
      "col": 1,
      "type": "backend",
      "label": "makeTemplate",
      "sublabel": "HTML slots + refine",
      "width": 132
    },
    {
      "id": "draft",
      "lane": "engine",
      "col": 3,
      "type": "backend",
      "label": "draftCarousel",
      "sublabel": "POST /styles/:id/draft",
      "width": 132
    },
    {
      "id": "gen",
      "lane": "engine",
      "col": 4,
      "type": "backend",
      "label": "generateCreative",
      "sublabel": "Satori + resvg render",
      "width": 132
    },
    {
      "id": "llm",
      "lane": "data",
      "col": 1,
      "type": "external",
      "label": "Vision LLM",
      "sublabel": "claude.complete",
      "width": 132
    },
    {
      "id": "styles",
      "lane": "data",
      "col": 2,
      "type": "database",
      "label": "style_refs",
      "sublabel": "spec · source · plate",
      "width": 132
    },
    {
      "id": "img",
      "lane": "data",
      "col": 4,
      "type": "external",
      "label": "Image model",
      "sublabel": "gemini-2.5-flash-image",
      "width": 132
    },
    {
      "id": "assets",
      "lane": "data",
      "col": 5,
      "type": "database",
      "label": "content_assets",
      "sublabel": "PNG / JPEG / MP4 rows",
      "width": 132
    }
  ],
  "edges": [
    {
      "id": "e-upload",
      "from": "upload",
      "to": "create",
      "label": "multipart",
      "variant": "emphasis"
    },
    {
      "id": "e-analyse",
      "from": "create",
      "to": "llm",
      "label": "analyse",
      "variant": "emphasis"
    },
    {
      "id": "e-spec",
      "from": "llm",
      "to": "tpl",
      "label": "spec",
      "variant": "emphasis"
    },
    {
      "id": "e-save-style",
      "from": "tpl",
      "to": "styles",
      "label": "insert",
      "variant": "emphasis"
    },
    {
      "id": "e-fix",
      "from": "styles",
      "to": "fix",
      "label": "remake / preview",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e-structure",
      "from": "styles",
      "to": "draft",
      "label": "structure",
      "variant": "emphasis"
    },
    {
      "id": "e-text",
      "from": "draft",
      "to": "gen",
      "label": "slide text",
      "variant": "emphasis"
    },
    {
      "id": "e-image",
      "from": "gen",
      "to": "img",
      "label": "fresh / new shape",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e-save-item",
      "from": "gen",
      "to": "assets",
      "label": "saveItemCreative",
      "variant": "emphasis"
    },
    {
      "id": "e-editor",
      "from": "editor",
      "to": "assets",
      "label": "upload · remove · read",
      "variant": "dashed",
      "role": "branch"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Cost scoping",
      "items": [
        "createStyle: style_analyze",
        "remakeTemplate: style_template",
        "draftCarousel: style_draft",
        "generate + saveItemCreative: style_generate"
      ]
    },
    {
      "dot": "rose",
      "title": "Item asset rules",
      "items": [
        "Locked once the post is approved",
        "Up to 10 images or one MP4, replaced in one tx",
        "Analysis + templates saved once; previews $0"
      ]
    }
  ]
}
