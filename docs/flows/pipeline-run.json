  "cards": [
    {
      "dot": "cyan",
      "title": "Order",
      "items": [
        "MODULES runs 9 stages in sequence so one /run carries a signal from research to analytics",
        "Publisher reads only v_publish_ready: approved and proof-complete"
      ]
    },
    {
      "dot": "rose",
      "title": "Fault isolation",
      "items": [
        "runModule catches every error and records it to content.module_runs",
        "A failed module never stops the ones after it"
      ]
    },
    {
      "dot": "emerald",
      "title": "Read side",
      "items": [
        "GET /health: 200 always; non-admins see only the overall state",
        "GET /pipeline: 25 recent content items, 503 on DB error"
      ]
    }
  ]
}