      "variant": "default",
      "role": "branch"
    },
    {
      "id": "orch-find",
      "from": "orch",
      "to": "find",
      "variant": "emphasis"
    },
    {
      "id": "find-draft",
      "from": "find",
      "to": "draft",
      "variant": "default"
    },
    {
      "id": "draft-qc",
      "from": "draft",
      "to": "qc",
      "variant": "default"
    },
    {
      "id": "qc-approve",
      "from": "qc",
      "to": "approve",
      "label": "to approval",
      "variant": "security"
    },
    {
      "id": "approve-publish",
      "from": "approve",
      "to": "publish",
      "label": "approved",
      "variant": "emphasis"
    },
    {
      "id": "publish-learn",
      "from": "publish",
      "to": "learn",
      "variant": "default"
    },
    {
      "id": "orch-db",
