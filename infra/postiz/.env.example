# Copy to .env and fill in. Never commit the real .env.
# Where Postiz is reachable. Local: http://localhost:5000. VPS: https://postiz.your-domain.com
MAIN_URL=http://localhost:5000

# Generate: openssl rand -hex 32
JWT_SECRET=replace-with-long-random-string

# Supabase SESSION POOLER (Project Settings -> Database -> Connect -> Session pooler, port 5432).
# The direct db.*.supabase.co host is IPv6-only and usually unreachable from Docker.
# `?schema=postiz` puts Postiz's tables in their own schema, away from `content` and `public`.
# Percent-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
POSTIZ_DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-1-YOUR-REGION.pooler.supabase.com:5432/postgres?schema=postiz

# Set true after you create your account.
DISABLE_REGISTRATION=false

# Social apps — fill as you connect each platform.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
