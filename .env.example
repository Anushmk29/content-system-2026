# Content Studio settings. Copy to .env (never commit it) and fill in.
# Only the four REQUIRED lines are needed to start; every integration left blank shows as
# "not configured" on the System page and its module is skipped. Details: docs/operations/GO-LIVE.md.

# --- REQUIRED --------------------------------------------------------------------------------
# Postgres (Supabase: session pooler, port 5432). Apply the schema with `npm run migrate`.
CONTENT_DATABASE_URL=
# The client's dashboard password, 16+ characters. Outside `next dev` the app refuses to serve
# without it (or with a shorter one).
CONTENT_RUN_SECRET=
# Signs login cookies; 32+ random characters: openssl rand -hex 32
CONTENT_SESSION_KEY=
# Optional dedicated encryption key for settings saved in System (32+ characters).
# Set before the first save; keep stable and back it up. Defaults to CONTENT_SESSION_KEY.
# CONTENT_SETTINGS_KEY=
# Your (operator's) view-only login, 16+ characters. Optional, but must be 16+ if set.
CONTENT_ADMIN_SECRET=

# --- Running in production -------------------------------------------------------------------
# Sent as x-content-secret by an external scheduler; opens only the run routes. Not needed with
# the bundled scheduler (infra/app), which runs the pipeline directly.
CONTENT_CRON_SECRET=
# USD cap on paid calls (LLM, images, Jev, Apify) per rolling 24h. Blank = no cap. Recommended.
CONTENT_DAILY_BUDGET_USD=3
# Slack or Discord incoming-webhook URL; a message whenever a pipeline module fails.
CONTENT_ALERT_WEBHOOK=
# How many reverse proxies sit in front of the app (Caddy in infra/app = 1).
CONTENT_PROXY_HOPS=1
# DB TLS verifies remote servers by default, including Supabase's bundled CA.
# Supply a custom CA path when needed. Explicit overrides: require | no-verify | disable.
CONTENT_DATABASE_CA=
CONTENT_DATABASE_SSL=
# json (default in production) or text
CONTENT_LOG_FORMAT=

# --- LLM (OpenRouter) -----------------------------------------------------------------------
CONTENT_OPENROUTER_API_KEY=
# Optional: OpenRouter management key, lets the Costs page check spend day by day.
CONTENT_OPENROUTER_MGMT_KEY=
# Optional model overrides.
CONTENT_LLM_MODEL=
CONTENT_IMAGE_MODEL=
# Live web check (default perplexity/sonar), "tinyfish", or "off". Runs once per topic, when it is drafted.
CONTENT_RESEARCH_MODEL=
# Cheap model for topic extraction (default deepseek/deepseek-v4.1-flash); "off" = the main model.
CONTENT_CHEAP_MODEL=

# --- Jev decision model (served through OpenRouter on the same key) --------------------------
# off | shadow (default) | primary
CONTENT_JEV_MODE=
CONTENT_JEV_MODEL=
# Tasks Jev decides first even in shadow mode, e.g. topic_score,qc_signals
CONTENT_JEV_PRIMARY_TASKS=
CONTENT_JEV_MIN_CONFIDENCE=

# --- Publishing (Postiz, see infra/postiz) ---------------------------------------------------
CONTENT_POSTIZ_API_URL=
CONTENT_POSTIZ_API_KEY=
# 1 = planning a post on the Calendar books it in Postiz right away
CONTENT_POSTIZ_SYNC=
# Hour (UTC) each platform's daily post goes out. Default 4 = 09:30 IST.
CONTENT_POST_HOUR_UTC=
CONTENT_DEFAULT_UTM_CAMPAIGN=

# --- Market signals --------------------------------------------------------------------------
# RSS/Atom feeds ("name=url" or bare url, comma-separated) and Reddit search terms.
CONTENT_MARKET_FEEDS=
CONTENT_REDDIT_QUERIES=
# X API v2 recent search: comma-separated queries + app bearer token.
CONTENT_X_QUERIES=
CONTENT_X_BEARER_TOKEN=
# TinyFish free web search: key, news queries, competitor pages to watch.
CONTENT_TINYFISH_API_KEY=
CONTENT_TINYFISH_QUERIES=
CONTENT_TINYFISH_WATCH=

# --- Decode (competitor posts) ---------------------------------------------------------------
CONTENT_APIFY_TOKEN=
# Optional actor-id overrides
CONTENT_APIFY_ACTOR_X=
CONTENT_APIFY_ACTOR_INSTAGRAM=
CONTENT_APIFY_ACTOR_LINKEDIN=
CONTENT_APIFY_ACTOR_FACEBOOK=
CONTENT_YOUTUBE_API_KEY=
# Local transcription (yt-dlp + faster-whisper on this host; not in the Docker image)
CONTENT_YTDLP=
CONTENT_PYTHON=
CONTENT_WHISPER_MODEL=
CONTENT_TRANSCRIBE_CAP=

# --- Behaviour switches ----------------------------------------------------------------------
# Auto-select up to N high-band topics per run for drafting. 0 = you pick.
CONTENT_AUTO_SELECT_TOPICS=
# 1 = Jev picks which platforms each idea suits
CONTENT_PLATFORM_FIT=
# 1 = "Request changes" rewrites the post from your feedback
CONTENT_REVISE_ON_CHANGES=
# 0 = don't rewrite drafts that score under 70 on the human check
CONTENT_HUMANIZE_REWRITE=

# --- Deploy (infra/app) ----------------------------------------------------------------------
# Public hostname Caddy gets a certificate for
DOMAIN=
